# OpenWeatherMap API Key
# Get your free API key at: https://openweathermap.org/api
# 1. Sign up for a free account
# 2. Go to API keys section
# 3. Copy your API key
# 4. Create a .env.local file and add your key below

NEXT_PUBLIC_WEATHER_API_KEY=your_api_key_here

# Gmail SMTP Configuration for Contact Form
# You need to create an App Password for your Gmail account
# See instructions in the README for how to set this up

# Your Gmail address (this will be used to send emails)
GMAIL_USER=your.email@gmail.com

# Your Gmail App Password (NOT your regular password)
# Get this from: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_app_password_here

# Email address where contact form messages will be sent
# If not set, messages will be sent to GMAIL_USER
CONTACT_EMAIL=your.email@gmail.com
